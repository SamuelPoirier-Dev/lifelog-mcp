data "azurerm_client_config" "current" {}

# Created by infra/bootstrap/.
data "azurerm_resource_group" "lifelog" {
  name = "rg-lifelog"
}

locals {
  app_name = "lifelog"
  # Public URL computed rather than read from the Container App: the Entra app and the
  # app's own settings both need it, which would otherwise be a dependency cycle (D33).
  base_url = "https://${local.app_name}.${azurerm_container_app_environment.lifelog.default_domain}"
}

resource "random_string" "suffix" {
  length  = 6
  upper   = false
  special = false
}

# --- OAuth state storage (D30) ----------------------------------------------------------

resource "azurerm_storage_account" "oauth" {
  name                            = "stlifelogoauth${random_string.suffix.result}"
  resource_group_name             = data.azurerm_resource_group.lifelog.name
  location                        = data.azurerm_resource_group.lifelog.location
  account_tier                    = "Standard"
  account_replication_type        = "LRS"
  min_tls_version                 = "TLS1_2"
  allow_nested_items_to_be_public = false
  # Reached with the Container App's managed identity only.
  shared_access_key_enabled = false
  # The Azure portal browses the data with the signed-in identity, not a key.
  default_to_oauth_authentication = true
}

resource "azurerm_storage_table" "oauth" {
  name               = "oauthstate"
  storage_account_id = azurerm_storage_account.oauth.id
}

resource "azurerm_role_assignment" "app_oauth_table" {
  scope                = azurerm_storage_account.oauth.id
  role_definition_name = "Storage Table Data Contributor"
  principal_id         = azurerm_container_app.lifelog.identity[0].principal_id
}

# --- Container Apps ------------------------------------------------------------------------

# No Log Analytics workspace: logs are not kept (cost, privacy).
resource "azurerm_container_app_environment" "lifelog" {
  name                = "cae-lifelog"
  resource_group_name = data.azurerm_resource_group.lifelog.name
  location            = data.azurerm_resource_group.lifelog.location

  # Serverless profile (pay per use, scale to zero), added by Azure by default.
  workload_profile {
    name                  = "Consumption"
    workload_profile_type = "Consumption"
  }
}

# Secrets generated by Terraform (D34).
resource "random_password" "jwt_signing_key" {
  length  = 64
  special = false
}

resource "random_password" "oauth_storage_encryption_key" {
  length  = 64
  special = false
}

resource "azurerm_container_app" "lifelog" {
  name                         = local.app_name
  resource_group_name          = data.azurerm_resource_group.lifelog.name
  container_app_environment_id = azurerm_container_app_environment.lifelog.id
  revision_mode                = "Single"
  workload_profile_name        = "Consumption"

  identity {
    type = "SystemAssigned"
  }

  secret {
    name  = "entra-client-secret"
    value = azuread_application_password.lifelog.value
  }
  secret {
    name  = "jwt-signing-key"
    value = random_password.jwt_signing_key.result
  }
  secret {
    name  = "oauth-storage-encryption-key"
    value = random_password.oauth_storage_encryption_key.result
  }

  ingress {
    external_enabled = true
    target_port      = 8000
    transport        = "auto"

    traffic_weight {
      latest_revision = true
      percentage      = 100
    }
  }

  template {
    min_replicas = 0
    max_replicas = 1

    container {
      name   = local.app_name
      image  = var.image
      cpu    = 0.25
      memory = "0.5Gi"

      env {
        name  = "LIFELOG_AUTH"
        value = "entra"
      }
      env {
        name  = "LIFELOG_BASE_URL"
        value = local.base_url
      }
      env {
        name  = "LIFELOG_ENTRA_TENANT_ID"
        value = data.azurerm_client_config.current.tenant_id
      }
      env {
        name  = "LIFELOG_ENTRA_CLIENT_ID"
        value = azuread_application.lifelog.client_id
      }
      env {
        name        = "LIFELOG_ENTRA_CLIENT_SECRET"
        secret_name = "entra-client-secret"
      }
      env {
        name        = "LIFELOG_JWT_SIGNING_KEY"
        secret_name = "jwt-signing-key"
      }
      env {
        name  = "LIFELOG_ALLOWED_OIDS"
        value = join(",", var.allowed_oids)
      }
      env {
        name  = "LIFELOG_OAUTH_TABLE_ACCOUNT"
        value = azurerm_storage_account.oauth.name
      }
      env {
        name  = "LIFELOG_OAUTH_TABLE_NAME"
        value = azurerm_storage_table.oauth.name
      }
      env {
        name        = "LIFELOG_OAUTH_STORAGE_ENCRYPTION_KEY"
        secret_name = "oauth-storage-encryption-key"
      }
      env {
        name  = "LIFELOG_STORAGE"
        value = "table"
      }
      env {
        name  = "LIFELOG_TABLE_ACCOUNT"
        value = azurerm_storage_account.data.name
      }
      env {
        name  = "LIFELOG_TABLE_NAME"
        value = azurerm_storage_table.entries.name
      }

      # TCP probes only: no public /health route (D20).
      liveness_probe {
        transport = "TCP"
        port      = 8000
      }
      readiness_probe {
        transport = "TCP"
        port      = 8000
      }
    }
  }

  lifecycle {
    # Deployments change the image (GitHub Actions, D66): var.image is only the image of
    # the first creation, and an apply must not roll the app back to it.
    ignore_changes = [template[0].container[0].image]
  }
}

# --- Budget (D29) --------------------------------------------------------------------------

resource "azurerm_consumption_budget_subscription" "monthly" {
  name            = "budget-lifelog"
  subscription_id = "/subscriptions/${var.subscription_id}"
  amount          = var.budget_amount
  time_grain      = "Monthly"

  time_period {
    start_date = var.budget_start_date
  }

  notification {
    enabled        = true
    threshold      = 80
    operator       = "GreaterThan"
    threshold_type = "Actual"
    contact_emails = [var.budget_email]
  }

  notification {
    enabled        = true
    threshold      = 100
    operator       = "GreaterThan"
    threshold_type = "Forecasted"
    contact_emails = [var.budget_email]
  }
}
